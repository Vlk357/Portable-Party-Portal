{
    "name": "root/project",
    "require": {
        "symfony/runtime": "^7.2",
        "symfony/yaml": "^7.2"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "require-dev": {},
    "scripts": {
