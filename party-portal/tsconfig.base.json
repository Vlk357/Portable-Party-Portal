{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@party-portal/auth": ["apps/frontend/auth/src/index.ts"],
      "@party-portal/chat": ["apps/frontend/chat/src/index.ts"],
      "@party-portal/video": ["apps/frontend/video/src/index.ts"],
      "@party-portal/shell/*": ["apps/frontend/shell/src/*"]
    },
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "composite": true, // Crucial for project references to work correctly
    "types": ["node", "jest"] // Add "jest" and "node" here
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
