{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../../../dist/out-tsc",
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "typeRoots": [
      "./node_modules/@types",
      "../../../node_modules/@types",
      "./src/types"
    ]
  },
  "include": ["../**/*.ts", "../**/*.tsx", "vite.config.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "jest.config.ts"],
  "references": [
    { "path": "../auth" },
    { "path": "../chat" },
    { "path": "../gallery" },
    { "path": "../video" }
  ]
}
