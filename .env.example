# Party Portal - Root Environment Variables
# -----------------------------------------------------------------------------
# This file contains environment variables for all services in the Party Portal.
# Docker Compose will use this file by default.
#
# IMPORTANT: Variables marked with "!!! CHANGE ME !!!" are critical secrets
# or configurations that you MUST update for your environment.
# -----------------------------------------------------------------------------

# === General Environment Modes ===
# These control the behavior of applications (e.g., debugging, optimizations).
# Typically 'prod' for production-like local setups, 'dev' for active development.
SYMFONY_ENV=prod
NODE_ENV=production


# === PostgreSQL Database Credentials ===
# These are used by the PostgreSQL service itself and by other services to connect.

# Root user for PostgreSQL instance management.
# Used by docker-entrypoint-initdb.d scripts to create other users/databases.
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=a_very_strong_password_for_postgres_CHANGE_ME # !!! CHANGE ME !!! Strong password for the PostgreSQL root user.

# --- Auth Service Database ---
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_db_password_CHANGE_ME # !!! CHANGE ME !!! Password for the auth service database user.
AUTH_DB_NAME=auth_db

# --- Chat Service Database ---
CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=chat_db_password_CHANGE_ME # !!! CHANGE ME !!! Password for the chat service database user.
CHAT_DB_NAME=chat_db

# --- Gallery Service Database ---
GALLERY_DB_USER=gallery_user
GALLERY_DB_PASSWORD=gallery_db_password_CHANGE_ME # !!! CHANGE ME !!! Password for the gallery service database user.
GALLERY_DB_NAME=gallery_db


# === Auth Service (Symfony) Secrets ===
# Secrets specific to the authentication service.

# Symfony's application secret key. Used for CSRF protection, signing cookies, etc.
# Should be a long, random, and unique string.
AUTH_APP_SECRET=auth_app_secret_CHANGE_ME_TO_BE_VERY_STRONG_AND_UNIQUE # !!! CHANGE ME !!!

# Passphrase for decrypting the JWT private key (`private.pem`).
# This passphrase was set when you generated the private.pem key for JWT signing.
# The auth service uses this to unlock the private key to sign new JWTs.
JWT_PRIVATE_KEY_PATH=/var/www/apps/auth-service/config/jwt/private.pem # !!! CHANGE ME !!!
AUTH_JWT_PASSPHRASE=ae15512eb6181206e858738e9fb2746459968474409a92811da9238066e1d9be # !!! CHANGE ME !!!
JWT_PUBLIC_KEY_PATH=/var/www/apps/auth-service/config/jwt/public.pem

# Admin user credentials (if your app:init-database command uses these).
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=superSecretPassword_forTestingPurposes_CHANGE_ME # !!! CHANGE ME !!!

# Credentials for Chat Service to identify itself to Auth Service (e.g., for internal API calls).
# These would be configured in the Auth service as a trusted client.
CHAT_SERVICE_ID=CHAT
CHAT_SERVICE_SECRET=chat_service_secret_CHANGE_ME # !!! CHANGE ME !!!



# === Chat Service (Node.js) Secrets ===
# Secrets specific to the chat service.

# Credentials for an API user account that the Chat Service might use
# to authenticate with the Auth Service for protected operations (e.g., fetching user details).
# This user (chat_service_api_user_in_auth_db) needs to exist in the Auth service's database.
CHAT_SERVICE_API_USER=chat_service_api_user_in_auth_db
CHAT_SERVICE_API_PASSWORD=chat_service_api_password_CHANGE_ME # !!! CHANGE ME !!!


# === Cinema Service (Symfony) Secrets ===
# Secrets specific to the cinema/video streaming service.

# Symfony's application secret key for the Cinema service.
CINEMA_APP_SECRET=cinema_app_secret_CHANGE_ME_TO_BE_VERY_STRONG_AND_UNIQUE # !!! CHANGE ME !!!

# Host path for the movies directory. Create this directory on your host machine.
# The Docker container will mount this directory to access video files.
# Example Linux/macOS: MOVIES_DIRECTORY=/home/yourusername/Videos/PartyPortalMovies
# Example Windows: MOVIES_DIRECTORY=C:/Users/YourUserName/Videos/PartyPortalMovies
# Using a relative path from project root is often simplest if media is stored within the project:
MOVIES_DIRECTORY=./media/movies # Ensure 'media/movies' directory exists at project root.


# === Mercure (Real-time Updates) ===
# Configuration for the Mercure hub.

# Internal URL used by backend services (e.g., Cinema) to publish updates to Mercure.
# This path is usually proxied by Nginx.
MERCURE_URL=https://nginx/mercure/.well-known/mercure # Corrected to use nginx hostname and https
# Public URL used by frontend clients to subscribe to Mercure updates.
# This path is usually proxied by Nginx.
MERCURE_PUBLIC_URL=https://<YOUR_SERVER_LAN_IP_OR_DOMAIN>:8443/.well-known/mercure # !!! CHANGE ME !!!

# JWT secret key used by backend services to authorize publishing to Mercure.
# Also used by Mercure hub (as MERCURE_PUBLISHER_JWT_KEY) to verify these tokens.
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKeyAndMakeItVeryStrong! # !!! CHANGE ME !!!


# === Gallery Service (Symfony) Secrets ===
# Secrets specific to the gallery service.

# Symfony's application secret key for the Gallery service.
GALLERY_APP_SECRET=gallery_app_secret_CHANGE_ME_TO_BE_VERY_STRONG_AND_UNIQUE # !!! CHANGE ME !!!

# Host path for gallery uploads. Create this directory on your host machine.
# The Docker container will mount this directory for storing uploaded images.
# Example Linux/macOS: HOST_GALLERY_UPLOADS_DIRECTORY=/home/yourusername/Pictures/PartyPortalGallery
# Example Windows: HOST_GALLERY_UPLOADS_DIRECTORY=C:/Users/YourUserName/Pictures/PartyPortalGallery
# Using a relative path from project root:
HOST_GALLERY_UPLOADS_DIRECTORY=./media/gallery_uploads # Ensure 'media/gallery_uploads' directory exists.


# === Xdebug (Optional, for PHP services development) ===
# Uncomment and configure if you need Xdebug for PHP debugging.
# XDEBUG_MODE=off # Set to 'debug' or other modes as needed.
# XDEBUG_CLIENT_PORT=9003 # Default Xdebug port.