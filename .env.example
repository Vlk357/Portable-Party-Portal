# === General Environment Modes ===
# Controls Symfony's behavior (dev, prod, test)
SYMFONY_ENV=prod
# Controls Node.js behavior (development, production)
NODE_ENV=production


# === PostgreSQL Credentials ===
# Root user for DB management (e.g., creating other users/DBs in init scripts)
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=postgres_password_CHANGE_ME

# Auth Service Database User
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password_CHANGE_ME

# Chat Service Database User
CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=chat_password_CHANGE_ME


# === Auth Service (Symfony) Secrets ===
# Symfony's application secret key
SYMFONY_APP_SECRET=symfony_secret_key_CHANGE_ME
# Passphrase for decrypting the JWT private key
AUTH_JWT_PASSPHRASE=passphrase_for_jwt_private_key_CHANGE_ME
# Admin user credentials (if managed via env)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin_password_CHANGE_ME


# === Chat Service Secrets ===
# Credentials for Chat service to authenticate with Auth service API
CHAT_SERVICE_API_USER=chat_service_user # User account within Auth service for API access
CHAT_SERVICE_API_PASSWORD=chat_service_api_password_CHANGE_ME # Password for the above user


# === Cinema ===
CINEMA_APP_SECRET=This_isSOME-SecretCHANGE_ME
# Define a host path for the movies directory. Create this directory on your host machine.
# Ensure this directory exists and is readable by the Docker process.
# Example Linux/macOS: MOVIES_DIRECTORY=/home/yourusername/Videos/PartyPortalMovies
# Example Windows: MOVIES_DIRECTORY=C:/Users/YourUserName/Videos/PartyPortalMovies
MOVIES_DIRECTORY=./media/movies # Using a relative path from project root is often simplest


# === Mercure ===
MERCURE_JWT_SECRET=!VeryStrongSecretKeyForMercure!CHANGE_ME

# === Gallery Service ===
GALLERY_APP_SECRET=your_strong_gallery_app_secret_CHANGE_ME
GALLERY_DB_USER=gallery_user
GALLERY_DB_PASSWORD=gallery_password_CHANGE_ME
GALLERY_DB_NAME=gallery_db
# Define a host path for gallery uploads. Create this directory on your host machine.
# Ensure this directory exists and is writable by the Docker process.
# Example Linux/macOS: HOST_GALLERY_UPLOADS_DIRECTORY=/home/yourusername/Pictures/PartyPortalGallery
# Example Windows: HOST_GALLERY_UPLOADS_DIRECTORY=C:/Users/YourUserName/Pictures/PartyPortalGallery
HOST_GALLERY_UPLOADS_DIRECTORY=./media/gallery_uploads # Using a relative path from project root

